    "date-fns": "^4.4.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
